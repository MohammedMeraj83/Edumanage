FLASK_ENV=development
SECRET_KEY=change-this-to-a-long-random-string

# Optional browser push notifications (generate with `flask --app app generate-vapid-keys`)
# Add the generated keys to your private .env. Keep VAPID_PRIVATE_KEY secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_EMAIL=mailto:admin@example.com

# Database connection:
# Option A: Full connection URL (PostgreSQL / MySQL / Aiven / Render)
# DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname?sslmode=require
#
# Option B: Individual variables (PostgreSQL or MySQL)
# DB_TYPE=postgresql  # or mysql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=edumanage
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=edumanage

# First Owner account (used by `flask seed`)
OWNER_NAME=Institute Owner
OWNER_USERNAME=owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=ChangeMe@123

# Institute defaults (used by `flask seed`)
INSTITUTE_NAME=My Tuition Institute
MAIN_BRANCH_NAME=Main Branch
MAIN_BRANCH_CODE=MAIN
